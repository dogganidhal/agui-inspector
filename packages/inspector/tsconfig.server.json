{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "stripInternal": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/server/**/*", "src/cli/**/*", "src/headless/**/*", "src/static-path.js"]
}
