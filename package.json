{
  "name": "agui-inspector-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "AG-UI inspector workspace for the 0.1.0 MVP. Private and not published.",
  "type": "module",
  "workspaces": [
    "packages/inspector",
    "packages/python"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/inspector/tsconfig.json",
    "test:unit": "node scripts/test-build.mjs",
    "build": "node scripts/build.mjs",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "check:bundle:renderer": "node scripts/bundle-budget.mjs --representative",
    "test:e2e": "playwright test",
    "test:benchmark": "node scripts/benchmark.mjs",
    "check:ci": "node scripts/ci.mjs",
    "package:python": "node scripts/package-python.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "dompurify": "3.4.16"
  },
  "license": "MIT"
}
